# Переносы строк.
# В репозитории всегда LF, независимо от того, кто как ставил Git.
* text=auto

# Исполняется внутри Linux-контейнеров: только LF.
# С CRLF внутри образа получаем "bad interpreter: /bin/sh^M".
*.sh          text eol=lf
Dockerfile    text eol=lf
*.dockerfile  text eol=lf
.dockerignore text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Скрипты для Windows: только CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Фикстуры: фиксированный LF, чтобы тесты давали одинаковый
# результат на всех машинах.
*.csv  text eol=lf
*.json text eol=lf

# Исходники и документация.
*.py   text
*.ts   text
*.tsx  text
*.sql  text
*.md   text
*.toml text
*.cfg  text
*.ini  text

# Бинарные: не нормализовать, не показывать построчный дифф.
*.parquet binary
*.cbm     binary
*.onnx    binary
*.pkl     binary
*.joblib  binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.xlsx    binary
*.woff    binary
*.woff2   binary
*.mbtiles binary
