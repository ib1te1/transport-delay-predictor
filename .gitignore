# Editor local config
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Data & models (кроме фикстур)
data/*
!data/fixtures/
!data/fixtures/**
# Keeps data/dataset/ present in a clone so Docker does not create it as
# root on Linux; its contents stay ignored.
!data/dataset/
data/dataset/*
!data/dataset/.gitkeep
models/*
!models/.gitkeep
# The current model artifact is committed: the system must start without training.
!models/current/
*.parquet
*.csv
!data/fixtures/**/*.csv
# The synthetic dataset of the end-to-end suite.
!tests/e2e/data/**/*.csv

# Env & local
.env
.env.local
*.log
