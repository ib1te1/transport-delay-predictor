# cp .env.example .env
#
# Compose substitutes these into docker-compose.yml. The defaults there
# are identical, so a local run works without .env.
POSTGRES_USER=delay_predictor
POSTGRES_PASSWORD=delay_predictor
POSTGRES_DB=delay_predictor

# Host ports for Postgres and Redis, always bound to 127.0.0.1. Change
# them when something local already holds 5432 or 6379, and change the
# URLs at the bottom to match.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Who can reach api and web. 127.0.0.1 is this machine only. On a stand
# opened from other computers set BIND_ADDR=0.0.0.0 and PUBLIC_API_URL to
# http://<server-address>:8000: the browser reads that URL, and localhost
# there is the viewer's own machine.
BIND_ADDR=127.0.0.1
PUBLIC_API_URL=http://localhost:8000

# For a service run from a venv against the compose infrastructure; read
# by ServiceSettings. Containers get their own values from compose.
DATABASE_URL=postgresql://delay_predictor:delay_predictor@localhost:5432/delay_predictor
REDIS_URL=redis://localhost:6379/0
